{
	"$schema": "https://unpkg.com/knip@5/schema.json",

	// SvelteKit's own plugin contributes the route entries, so listing
	// `src/routes/**/+page` etc. here is redundant -- knip said so itself
	// ("Remove redundant entry pattern"). Only genuinely extra entries belong
	// below. `src/hooks.{server,client}` was also listed and matched nothing:
	// this app has no hooks files, by design.
	"entry": ["scripts/*.ts"],

	// CSS is in `project` so knip follows `@import` statements. Without it, the
	// three packages imported at src/app.css:2-4 (@fontsource-variable/roboto-flex,
	// @fontsource/roboto-slab, tw-animate-css) were reported unused -- knip
	// flagged the cause itself as "Compiled extension excluded by project".
	"project": ["src/**/*.{js,ts,svelte,css}", "scripts/**/*.{ts,js}"],

	"ignore": [
		// The CSS half of the legacy port. Still dead as an ENTRY:
		// nothing imports src/routes/layout.css, which additionally pulls
		// @sfgov/design-system (the Tailwind v3 bundle whose 7,714 !important
		// declarations beat every v4 utility -- see PLAN.md B3). Deleting the
		// legacy port is one decision covering it; see PLAN.md B5.
		"src/routes/layout.css",

		// NOT the whole src/css subtree any more, as of 2026-08-23. Two of
		// those files are now live: src/app.css imports ./css/sfds.css and
		// ./css/theme.css, which are the SFDS token layer the design handoff
		// builds on. knip resolves them through app.css on its own, so they
		// must not be ignored -- an ignore here would hide a real regression
		// if that import were ever dropped. tests/theme.test.ts guards it too.
		// The remaining nine are legacy component stylesheets and stay dead.
		"src/css/ai-assist.css",
		"src/css/ai-rewrite.css",
		"src/css/dashboard.css",
		"src/css/inline-content-edit.css",
		"src/css/karl-guide.css",
		"src/css/review-insights.css",
		"src/css/review-ops.css",
		"src/css/styles.css",
		"src/css/ux-improvements.css",

		// Vendored shadcn-svelte components, generated by its CLI. Their barrel
		// re-exports are the library's public API, not dead code -- they were
		// 12 of the 14 files carrying "unused export" findings and drowned the
		// real ones. Treated as third-party because that is what they are.
		"src/lib/components/ui/**"
	],

	"ignoreDependencies": ["@sveltejs/adapter-auto", "@testing-library/jest-dom"],

	// Windows-interop binaries used only by the `dev:op` script.
	"ignoreBinaries": ["op", "wsl.exe"]
}
