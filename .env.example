# Supabase Configuration
# Browser-reachable Supabase URL (the browser is not inside the Docker network)
SVELTE_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
# Server-only URL used by requests originating inside the container
SVELTE_PUBLIC_SUPABASE_SERVER_URL="http://host.docker.internal:54321"
SVELTE_PUBLIC_SUPABASE_ANON_KEY="your-local-anon-key-from-supabase-status"
SVELTE_PUBLIC_LOCAL_AUTH="true"
RAILWAY_API_URL="https://web-production-9bb3b.up.railway.app"
RAILWAY_API_TOKEN="your-railway-api-token"
