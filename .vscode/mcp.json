{
	"mcpServers": {
		"filesystem": {
			"command": "npx",
			"args": ["-y", "@modelcontextprotocol/server-filesystem", "."]
		},
		"github": {
			"command": "npx",
			"args": ["-y", "@modelcontextprotocol/server-github"],
			"env": {
				"GITHUB_PERSONAL_ACCESS_TOKEN": "${env:GITHUB_TOKEN}"
			}
		}
	},
	"servers": {
		"Sentry": {
			"url": "https://mcp.sentry.dev/mcp/glycolysis/javascript-sveltekit",
			"type": "http"
		}
	}
}
