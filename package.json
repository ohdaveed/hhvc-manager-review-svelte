{
	"name": "hhvc-manager-review-svelte",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"dev:op": "op run -- wsl.exe -e bash -c 'cd /home/ohdaveed/hhvc-manager-review-svelte && ~/.bun/bin/bun run dev'",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''; git config --local --unset core.hooksPath 2>/dev/null || true",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"lint:ratchet": "bun run scripts/eslint-ratchet.ts",
		"check:ratchet": "bun run scripts/check-ratchet.ts",
		"format:ratchet": "bun run scripts/prettier-ratchet.ts",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:unit": "vitest",
		"test:e2e": "playwright install chromium && playwright test",
		"test:coverage": "vitest run --coverage",
		"verify": "bash scripts/verify.sh",
		"verify:live": "bash scripts/verify.sh --live",
		"corpus:import": "bun run scripts/corpus-import.ts",
		"corpus:lock": "bun run scripts/corpus-lock.ts",
		"corpus:check": "bun run scripts/check-corpus-lock.ts",
		"env:local": "bun run scripts/env-target.ts local",
		"env:hosted": "bun run scripts/env-target.ts hosted",
		"env:status": "bun run scripts/env-target.ts status",
		"seed:gen": "bun run scripts/gen-seed.ts",
		"audit:privileges": "bun run scripts/audit-privileges.ts"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.12.4",
		"@playwright/test": "^1.65.1",
		"@sveltejs/adapter-netlify": "^6.0.4",
		"@sveltejs/adapter-node": "^5.2.0",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^22",
		"@types/pg": "^8.23.1",
		"@vitest/coverage-v8": "^4.1.11",
		"axe-core": "^4.14.1",
		"clsx": "^2.1.1",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"jsdom": "^30.0.1",
		"knip": "^6.47.0",
		"lefthook": "^2.2.2",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"shadcn-svelte": "^1.8.1",
		"supabase": "^2.115.0",
		"svelte": "^5.59.1",
		"svelte-check": "^4.7.8",
		"tailwind-merge": "^3.7.1",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.5",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.73.0",
		"vite": "^8.3.8",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"@fontsource-variable/roboto-flex": "^5.3.0",
		"@fontsource/roboto-slab": "^5.3.0",
		"@lucide/svelte": "^1.78.0",
		"@sentry/sveltekit": "^10",
		"@supabase/supabase-js": "^2.119.2",
		"bits-ui": "^2.21.0",
		"pg": "^8.23.1",
		"zod": "3.24.1"
	},
	"trustedDependencies": [
		"esbuild"
	],
	"type": "module"
}
