{
	"name": "hhvc-manager-review-svelte",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"dev:op": "op run -- wsl.exe -e bash -c 'cd /home/ohdaveed/hhvc-manager-review-svelte && ~/.bun/bin/bun run dev'",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''; git config --local --unset core.hooksPath 2>/dev/null || true",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"lint:ratchet": "bun run scripts/eslint-ratchet.ts",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:unit": "vitest",
		"test:e2e": "playwright install && playwright test",
		"test:coverage": "vitest run --coverage",
		"verify": "bash scripts/verify.sh",
		"verify:live": "bash scripts/verify.sh --live",
		"verify:tools": "bun run scripts/verify-tooling.ts",
		"context:pack": "repomix",
		"corpus:import": "bun run scripts/corpus-import.ts",
		"corpus:lock": "bun run scripts/corpus-lock.ts",
		"corpus:check": "bun run scripts/check-corpus-lock.ts",
		"ast:scan": "ast-grep scan",
		"env:local": "bun run scripts/env-target.ts local",
		"env:hosted": "bun run scripts/env-target.ts hosted",
		"env:status": "bun run scripts/env-target.ts status",
		"seed:gen": "bun run scripts/gen-seed.ts",
		"audit:privileges": "bun run scripts/audit-privileges.ts"
	},
	"devDependencies": {
		"@ast-grep/cli": "^0.45.1",
		"@axe-core/playwright": "^4.13.0",
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.2",
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.12.0",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-netlify": "^6.0.4",
		"@sveltejs/adapter-node": "^5.2.0",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^22",
		"@vitest/coverage-v8": "^4.1.11",
		"clsx": "^2.1.1",
		"danger": "^13.0.10",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"jsdom": "^30.0.1",
		"knip": "^6.32.2",
		"lefthook": "^2.1.10",
		"lucide-svelte": "^1.0.1",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"repomix": "^1.18.0",
		"shadcn-svelte": "^1.5.0",
		"supabase": "^2.115.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"@fontsource-variable/roboto-flex": "^5.3.0",
		"@fontsource/roboto-slab": "^5.3.0",
		"@sentry/sveltekit": "^10",
		"@supabase/supabase-js": "^2.112.3",
		"bits-ui": "^2.19.0",
		"pg": "^8.23.0"
	},
	"type": "module",
	"trustedDependencies": [
		"@ast-grep/cli"
	]
}
